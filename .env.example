# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only – writes quiz attempts (graded on the server). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the app (used for links in Slack messages)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Slack app (Bot token with chat:write, im:write, users:read, users:read.email)
SLACK_BOT_TOKEN=xoxb-...

# Notion internal integration (read access), shared with the "Klassen Datenbank".
# NOTION_CLASSES_DB is the database's data source id; it feeds the class picker in the Messenger examples.
NOTION_TOKEN=secret_...
NOTION_CLASSES_DB=f8e16934-f1a1-4800-bc35-840371275d40

# AI reply assistant (/assistent). Claude API key; ASSISTANT_MODEL is optional (default claude-haiku-5-5).
ANTHROPIC_API_KEY=sk-ant-...
# ASSISTANT_MODEL=claude-haiku-5-5
# Data source id of the Notion „Nachrichten Q&A Datenbank“. Share it with the NOTION_TOKEN integration with edit access.
NOTION_REPLY_EXAMPLES_DB=879cd7c6-47fb-434d-b3d3-7a8c8a1f80b2

# Facebook Page Messenger inbox (read-only copy, synced every minute by /api/cron/messenger-sync).
# Page access token from the "NaNu Wiki Inbox" Meta app → Messenger API Settings → Generate. Never expose to the browser.
META_PAGE_ACCESS_TOKEN=EAA...
META_PAGE_ID=100573835262458
# Shared secret for /api/cron/* (sent as "Authorization: Bearer ..." by the scheduler)
CRON_SECRET=some-long-random-string

# WhatsApp Business, shown in the same inbox. Callback: https://<site>/api/whatsapp/webhook
# App settings → Basic → App secret. WhatsApp → Configuration → the same verify token.
# Subscribe the account to messages, smb_message_echoes, history, and smb_app_state_sync.
# Several phone number ids, separated by commas. Empty = every number on the account.
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Outgoing inbox messages. Keep false until the migration and account checks pass.
MESSENGER_SEND_ENABLED=false
WHATSAPP_SEND_ENABLED=false
META_GRAPH_VERSION=v23.0
MESSENGER_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_PHONE_NUMBER_IDS=number-id-1,number-id-2
