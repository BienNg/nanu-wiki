# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only – used by the Vercel cron job. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the app (used for links in Slack messages)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Slack app (Bot token with chat:write, im:write, users:read, users:read.email)
SLACK_BOT_TOKEN=xoxb-...

# Random string; Vercel sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=change-me
